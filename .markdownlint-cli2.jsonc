// Reviewed local Markdownlint configuration for FHT-Specification (issue #14).
// Pinned tool: markdownlint-cli2 0.24.0 (markdownlint rule set 0.42.0), run by
// .github/workflows/docs-checks.yml. Reproduce locally with:
//   npx -y markdownlint-cli2@0.24.0
// Defaults stay on; each deviation below is deliberate and recorded here.
{
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", ".git/**"],
  "config": {
    // MD013/line-length: the INSDC coverage and mapping matrices in specs/ use
    // wide table rows (up to ~450 columns) that cannot be reflowed without
    // rewriting recorded audit content, and AGENTS.md is ported byte-identical
    // from the shared specification. Prose width here is not a correctness
    // property; whitespace and link checks remain enforced.
    "MD013": false,
    // MD060/table-column-style: the coverage matrices use a compact pipe
    // style (no padding). It is consistent within each table and cosmetic to
    // change; preserved as written.
    "MD060": false
  }
}
