{
  "missing-checksum.json": [
    {
      "path": [],
      "contains": [
        "'checksum' is a required property"
      ]
    }
  ],
  "missing-masking.json": [
    {
      "path": [],
      "contains": [
        "'masking' is a required property"
      ]
    }
  ],
  "unknown-top-level-property.json": [
    {
      "path": [],
      "contains": [
        "Additional properties are not allowed",
        "'maskingPolicy'"
      ]
    }
  ],
  "schemaversion-string.json": [
    {
      "path": [
        "schemaVersion"
      ],
      "contains": [
        "is not of type 'number'"
      ]
    }
  ],
  "transcriptome-number.json": [
    {
      "path": [
        "transcriptome"
      ],
      "contains": [
        "is not of type 'string'"
      ]
    }
  ],
  "masking-hard-masked.json": [
    {
      "path": [
        "masking"
      ],
      "contains": [
        "does not match",
        "not-masked"
      ]
    }
  ],
  "checksum-md5-prefixed.json": [
    {
      "path": [
        "checksum"
      ],
      "contains": [
        "is too short"
      ]
    },
    {
      "path": [
        "checksum"
      ],
      "contains": [
        "does not match",
        "[A-Za-z0-9/+=]"
      ]
    }
  ],
  "checksum-bad-charset.json": [
    {
      "path": [
        "checksum"
      ],
      "contains": [
        "does not match"
      ]
    }
  ],
  "datecreated-prose.json": [
    {
      "path": [
        "dateCreated"
      ],
      "contains": [
        "is not a 'date'"
      ]
    }
  ],
  "taxon-uri-no-pattern.json": [
    {
      "path": [
        "taxon",
        "uri"
      ],
      "contains": [
        "does not match"
      ]
    }
  ],
  "relatedlink-not-a-uri.json": [
    {
      "path": [
        "relatedLink",
        "0"
      ],
      "contains": [
        "is not a 'uri'"
      ]
    }
  ]
}
